# Copier ce fichier en .env puis remplir les valeurs.

# Base PostgreSQL (docker compose expose la base sur le port 5433).
DATABASE_URL="postgresql://ofrero:ofrero@localhost:5433/ofrero"

# Authentification (Better Auth). Secret aleatoire d'au moins 32 caracteres :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique du site (sert aux liens des e-mails et au suivi de commande).
BETTER_AUTH_URL="http://localhost:3000"

# Stripe (facultatif en local : sans cle, seul le paiement au retrait fonctionne).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# E-mails via Resend (facultatif : sans cle, les e-mails sont ecrits dans la console du serveur).
RESEND_API_KEY=""
EMAIL_FROM="O'Frero <commandes@ofrero.fr>"

# Compte administrateur cree par le seed.
ADMIN_EMAIL="admin@ofrero.fr"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin O'Frero"
