# Copier ce fichier en `.env` et renseigner les vraies valeurs. Ne jamais commiter `.env`.

# --- Base de données ---
DATABASE_URL="postgresql://user:password@localhost:5432/ofrero"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"

# --- Compte admin (créé automatiquement au démarrage si absent) ---
ADMIN_EMAIL="admin@ofrero.fr"
ADMIN_FULLNAME="Admin O'Frero"
ADMIN_PASSWORD="change-me"

# --- Serveur ---
PORT=5050
FRONT_URL="http://localhost:3000"

# --- Stripe (clés de test) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
